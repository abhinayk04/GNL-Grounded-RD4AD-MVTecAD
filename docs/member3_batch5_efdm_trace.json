        "0018: def cal_anomaly_map(fs_list, ft_list, out_size=224, amap_mode='mul'):",
        "0019:     if amap_mode == 'mul':",
        "0020:         anomaly_map = np.ones([out_size, out_size])",
        "0021:     else:",
        "0022:         anomaly_map = np.zeros([out_size, out_size])",
        "0023:     a_map_list = []",
        "0024:     for i in range(len(ft_list)):",
        "0025:         fs = fs_list[i]",
        "0026:         ft = ft_list[i]",
        "0027:         a_map = 1 - F.cosine_similarity(fs, ft)",
        "0028:         a_map = torch.unsqueeze(a_map, dim=1)",
        "0029:         a_map = F.interpolate(a_map, size=out_size, mode='bilinear', align_corners=True)",
        "0030:         a_map = a_map[0, 0, :, :].to('cpu').detach().numpy()",
        "0031:         a_map_list.append(a_map)",
        "0032:         if amap_mode == 'mul':",
        "0033:             anomaly_map *= a_map",
        "0034:         else:",
        "0035:             anomaly_map += a_map",
        "0036:     return anomaly_map, a_map_list",
