        "0145: def mixstyle_test(input_image, normal_image, lamda = 0.5):",
        "0146:     input_x = input_image",
        "0147: ",
        "0148: ",
        "0149:     normal_x = normal_image",
        "0150: ",
        "0151: ",
        "0152:     B, C, W, H = input_x.size(0), input_x.size(1), input_x.size(2), input_x.size(3)",
        "0153: ",
        "0154: ",
        "0155:     mu = input_x.mean(dim=[2, 3], keepdim=True)",
        "0156:     var = input_x.var(dim=[2, 3], keepdim=True)",
        "0157:     sig = (var + 1e-6).sqrt()",
        "0158:     mu, sig = mu.detach(), sig.detach()",
        "0159:     x_normed = (input_x - mu) / sig",
        "0160: ",
        "0161:     mu2 = normal_x.mean(dim=[2, 3], keepdim=True)",
        "0162:     var2 = normal_x.var(dim=[2, 3], keepdim=True)",
        "0163:     sig2 = (var2 + 1e-6).sqrt()",
        "0164:     mu_mix = mu * lamda + mu2 * (1 - lamda)",
        "0165:     sig_mix = sig * lamda + sig2 * (1 - lamda)",
        "0166: ",
        "0167:     new_input_x = x_normed * sig_mix + mu_mix",
        "0168: ",
        "0169:     return new_input_x",
        "0170: ",
        "0171: def EFDM_test(input_image, normal_image, lamda = 0.5):",
        "0172: ",
        "0173:     lamda = 1-lamda",
        "0174:     input_x = input_image",
        "0175: ",
        "0176: ",
        "0177:     normal_x = normal_image",
        "0178: ",
        "0179: ",
        "0180:     B, C, W, H = input_x.size(0), input_x.size(1), input_x.size(2), input_x.size(3)",
        "0181: ",
        "0182: ",
        "0183:     input_x_view = input_x.view(B, C, -1)",
        "0184:     normal_x_view = normal_x.view(B, C, -1)",
        "0185: ",
        "0186:     value_input_x, index_input_x = torch.sort(input_x_view)",
        "0187:     value_normal_x, index_normal_x = torch.sort(normal_x_view)",
        "0188:     new_input_x = value_input_x + (value_normal_x - value_input_x) * lamda",
        "0189:     inverse_index = index_input_x.argsort(-1)",
        "0190:     new_input_x = new_input_x.gather(-1, inverse_index)",
        "0191:     new_input_x = new_input_x.view(B, C, W, H)",
        "0192:     new_input_x = new_input_x.cpu().detach().numpy()",
        "0193:     new_input_x = torch.from_numpy(new_input_x)",
        "0194: ",
        "0195:     return new_input_x",
